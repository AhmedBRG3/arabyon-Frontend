# Where booking + contact form submissions are POSTed (JSON).
# Works with Formspree, Web3Forms, Make/Zapier webhooks, etc.
# Leave empty and the forms run in demo mode (nothing is delivered).
VITE_FORM_ENDPOINT=

# ArabyOn.Api base URL as seen by the browser.
# Leave empty in dev: requests go to /api and Vite proxies them to API_PROXY_TARGET.
# Production: the API's own subdomain on the same registrable domain as the site
# (e.g. https://api.arabyon.com for https://arabyon.com), because the refresh cookie is SameSite=Strict.
VITE_API_URL=

# Dev/preview only (not exposed to the browser): where Vite forwards /api/*.
API_PROXY_TARGET=http://localhost:5137
